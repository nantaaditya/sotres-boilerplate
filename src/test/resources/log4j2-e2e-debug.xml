<?xml version="1.0" encoding="UTF-8"?>
<!-- Diagnostic-only Log4j2 config for the E2E harness: prints full stack traces
     that the application's custom layouts (TextLogLayout / JsonLogLayout) drop.
     Activate with -Dlogging.config=classpath:log4j2-e2e-debug.xml -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{1.} - %msg%n%throwable"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="com.nantaaditya.sotres" level="DEBUG"/>
    <Logger name="io.netty.channel" level="DEBUG"/>
    <Logger name="com.github.kpavlov.jreactive8583" level="DEBUG"/>
    <Logger name="io.r2dbc.postgresql" level="WARN"/>
    <Logger name="org.springframework" level="WARN"/>
    <Root level="INFO">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
