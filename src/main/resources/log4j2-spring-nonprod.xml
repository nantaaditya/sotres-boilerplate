<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">

  <Properties>
    <Property name="PROJECT_VERSION">${spring:app.version}</Property>
    <Property name="APP_NAME">${spring:spring.application.name}</Property>
    <Property name="LOG_PATH">${spring:logging.file.path}</Property>
    <Property name="LOG_PATTERN_TEXT">${spring:app.log-pattern-text}</Property>
    <Property name="ROOT_LOG_LEVEL">${spring:logging.level.root}</Property>
  </Properties>

  <Appenders>
    <Console
      name="consoleLog"
      target="SYSTEM_OUT"
    >
      <PatternLayout properties="true" stacktraceAsString="true">
        <pattern>${LOG_PATTERN_TEXT}</pattern>
      </PatternLayout>
    </Console>

    <RollingFile
      name="appLog"
      fileName="${LOG_PATH}/${APP_NAME}.log"
      filePattern="${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}.gz"
      immediateFlush="true"
    >
      <PatternLayout properties="true" stacktraceAsString="true">
        <pattern>${LOG_PATTERN_TEXT}</pattern>
      </PatternLayout>
      <Policies>
        <TimeBasedTriggeringPolicy
          interval="1"
          modulate="true"
        />
      </Policies>
      <DefaultRolloverStrategy max="7">
        <Delete basePath="${LOG_PATH}">
          <IfFileName glob="${APP_NAME}-*.gz"/>
          <IfLastModified age="P7D"/>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

    <RollingFile
      name="metricsLog"
      fileName="${LOG_PATH}/metrics.log"
      filePattern="${LOG_PATH}/metrics-%d{yyyy-MM-dd}.gz"
      immediateFlush="true"
    >
      <PatternLayout>
        <pattern>${LOG_PATTERN_TEXT}</pattern>
      </PatternLayout>
      <Policies>
        <TimeBasedTriggeringPolicy
          interval="1"
          modulate="true"
        />
      </Policies>
      <DefaultRolloverStrategy max="1">
        <Delete basePath="${LOG_PATH}">
          <IfFileName glob="metrics-*.gz"/>
          <IfLastModified age="P1D"/>
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

  </Appenders>

  <Loggers>
    <Logger name="com.nantaaditya.sotres.listener.ObservationListener" additivity="false">
      <AppenderRef ref="metricsLog"/>
    </Logger>
    <Root level="${ROOT_LOG_LEVEL}">
      <AppenderRef ref="consoleLog"/>
      <AppenderRef ref="appLog"/>
    </Root>
  </Loggers>
</Configuration>